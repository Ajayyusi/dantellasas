rules_version = '2';

// Dantella CRM — Firestore security rules.
//
// Model (docs/firestore-schema.md):
//  • Every tenant document lives under organizations/{orgId}.
//  • Access comes from organizations/{orgId}/members/{uid}:
//      { status, roleKey, permissions[], allBranches, branchIds[], staffId }
//    Members can't write their own membership, so nobody can grant themselves access.
//  • Reads are permission-aware and branch-scoped.
//  • The browser never writes domain data. All mutations run in Server Actions
//    (Admin SDK, bypasses these rules) after the same checks in code, because
//    many writes must update several documents atomically.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function member(orgId) {
      return get(memberPath(orgId)).data;
    }

    function isMember(orgId) {
      return signedIn() && exists(memberPath(orgId)) && member(orgId).status == 'active';
    }

    function hasPerm(orgId, permission) {
      return isMember(orgId) && permission in member(orgId).permissions;
    }

    function orgWide(orgId) {
      let m = member(orgId);
      return m.allBranches == true || m.roleKey in ['owner', 'admin'];
    }

    function branchOk(orgId, branchId) {
      return orgWide(orgId) || branchId in member(orgId).branchIds;
    }

    function isOwnStaff(orgId, staffId) {
      let m = member(orgId);
      return m.get('staffId', null) != null && m.staffId == staffId;
    }

    // ── Users ──────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'locale', 'lastOrgId', 'updatedAt']);
      allow create, delete: if false;

      match /orgs/{orgId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ── Organizations ──────────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isMember(orgId);
      allow write: if false;

      match /members/{memberUid} {
        allow read: if (signedIn() && request.auth.uid == memberUid) || hasPerm(orgId, 'manage_users');
        allow write: if false;
      }

      match /roles/{roleId} {
        allow read: if isMember(orgId);
        allow write: if false;
      }

      match /branches/{branchId} {
        allow read: if isMember(orgId);
        allow write: if false;
      }

      // Catalog shared by the calendar and checkout.
      match /serviceCategories/{id} {
        allow read: if isMember(orgId);
        allow write: if false;
      }
      match /services/{id} {
        allow read: if isMember(orgId);
        allow write: if false;
      }
      match /packages/{id} {
        allow read: if isMember(orgId);
        allow write: if false;
      }
      match /membershipPlans/{id} {
        allow read: if isMember(orgId);
        allow write: if false;
      }
      match /discounts/{id} {
        allow read: if hasPerm(orgId, 'create_sales') || hasPerm(orgId, 'manage_catalog');
        allow write: if false;
      }

      match /staff/{staffId} {
        allow read: if hasPerm(orgId, 'view_staff')
          || hasPerm(orgId, 'view_appointments')
          || hasPerm(orgId, 'create_sales');
        allow write: if false;
      }

      // Clients and everything attached to them.
      match /clients/{clientId} {
        allow read: if hasPerm(orgId, 'view_customers');
        allow write: if false;

        match /notes/{noteId} {
          allow read: if hasPerm(orgId, 'view_customers');
          allow write: if false;
        }
      }
      match /clientPackages/{id} {
        allow read: if hasPerm(orgId, 'view_customers');
        allow write: if false;
      }
      match /clientMemberships/{id} {
        allow read: if hasPerm(orgId, 'view_customers');
        allow write: if false;
      }

      // Calendar. Without view_all_appointments, only lines assigned to the
      // member's own staff record are visible.
      match /appointments/{id} {
        allow read: if hasPerm(orgId, 'view_appointments')
          && branchOk(orgId, resource.data.branchId)
          && (hasPerm(orgId, 'view_all_appointments')
              || (member(orgId).get('staffId', null) != null
                  && member(orgId).staffId in resource.data.staffIds));
        allow write: if false;
      }
      match /blockedTimes/{id} {
        allow read: if hasPerm(orgId, 'view_appointments') && branchOk(orgId, resource.data.branchId);
        allow write: if false;
      }

      // Money.
      match /transactions/{id} {
        allow read: if hasPerm(orgId, 'view_sales') && branchOk(orgId, resource.data.branchId);
        allow write: if false;
      }
      match /giftCards/{id} {
        allow read: if hasPerm(orgId, 'create_sales') || hasPerm(orgId, 'manage_catalog');
        allow write: if false;
      }
      match /expenses/{id} {
        allow read: if hasPerm(orgId, 'view_expenses') && branchOk(orgId, resource.data.branchId);
        allow write: if false;
      }
      match /expenseCategories/{id} {
        allow read: if hasPerm(orgId, 'view_expenses');
        allow write: if false;
      }
      match /commissionRules/{id} {
        allow read: if hasPerm(orgId, 'view_commissions') || hasPerm(orgId, 'manage_staff');
        allow write: if false;
      }
      match /counters/{id} {
        allow read, write: if false;
      }

      // Inventory.
      match /products/{id} {
        allow read: if hasPerm(orgId, 'manage_inventory') || hasPerm(orgId, 'create_sales');
        allow write: if false;
      }
      match /productCategories/{id} {
        allow read: if hasPerm(orgId, 'manage_inventory') || hasPerm(orgId, 'create_sales');
        allow write: if false;
      }
      match /suppliers/{id} {
        allow read: if hasPerm(orgId, 'manage_inventory') || hasPerm(orgId, 'view_expenses');
        allow write: if false;
      }
      match /inventoryMovements/{id} {
        allow read: if hasPerm(orgId, 'manage_inventory') && branchOk(orgId, resource.data.branchId);
        allow write: if false;
      }

      // People operations.
      match /attendance/{id} {
        allow read: if isMember(orgId)
          && ((hasPerm(orgId, 'manage_attendance') && branchOk(orgId, resource.data.branchId))
              || isOwnStaff(orgId, resource.data.staffId));
        allow write: if false;
      }
      match /leave/{id} {
        allow read: if hasPerm(orgId, 'manage_staff')
          || hasPerm(orgId, 'manage_attendance')
          || (isMember(orgId) && isOwnStaff(orgId, resource.data.staffId));
        allow write: if false;
      }

      match /notifications/{id} {
        allow read: if isMember(orgId);
        allow write: if false;
      }

      match /auditLogs/{id} {
        allow read: if hasPerm(orgId, 'view_audit_log');
        allow write: if false;
      }

      // Anything not listed above stays private.
      match /{collection}/{docId=**} {
        allow read, write: if false;
      }
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
