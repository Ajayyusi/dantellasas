# Copy to .env.local and fill in. Never commit real values.

# ── Platform branding ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Dantella CRM"
# Default UI language for first-time visitors: "en" or "ar"
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ── Firebase Web SDK (public — Firebase console › Project settings › Your apps)
# On Firebase App Hosting these are filled automatically from FIREBASE_WEBAPP_CONFIG.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Local emulators ───────────────────────────────────────────────────
# "true" points the browser SDK at the emulators. For the Admin SDK, also set
# the two *_EMULATOR_HOST variables below (the Admin SDK reads them directly).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Stops Google client libraries probing for a GCP metadata server locally.
# METADATA_SERVER_DETECTION=none

# ── Firebase Admin SDK (SERVER ONLY — never prefix with NEXT_PUBLIC_) ──
# Leave empty on App Hosting / Google Cloud (Application Default Credentials).
# Locally, either set GOOGLE_APPLICATION_CREDENTIALS to a key file path outside
# the repo, or fill these three from a service-account JSON.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the \n escapes; the app converts them to real newlines.
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Session ───────────────────────────────────────────────────────────
# Firebase allows 5 minutes – 14 days
SESSION_COOKIE_MAX_AGE_DAYS=5

# ── Features ──────────────────────────────────────────────────────────
# Shows "Load demo data" in Settings › Data for owners.
ALLOW_DEMO_DATA=true

# ── Platform admin (/admin) ───────────────────────────────────────────
# Comma-separated emails of the people who run the platform. Their Firebase
# account's email must be verified (Google sign-in always is). Empty = nobody.
# In production this comes from the Secret Manager secret platformAdminEmails.
PLATFORM_ADMIN_EMAILS=
