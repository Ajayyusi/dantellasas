# Copy to .env.local and fill in. Never commit real values.

# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Default UI locale: "ar" (RTL) or "en" (LTR)
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# ── Firebase Web SDK (public — from Firebase console > Project settings) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Set to "true" to point the web + admin SDKs at local emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# ── Firebase Admin SDK (SERVER ONLY — never prefix with NEXT_PUBLIC_) ──
# Option A: individual fields from a service-account JSON
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the \n escapes; the app converts them to real newlines.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Option B: leave the three above empty and rely on Application Default
# Credentials (e.g. GOOGLE_APPLICATION_CREDENTIALS or running on GCP).

# ── Session ────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=__session
# Firebase allows 5 minutes – 14 days
SESSION_COOKIE_MAX_AGE_DAYS=5

# ── Emulator hosts (used when NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true) ──
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
